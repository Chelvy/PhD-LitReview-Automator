# ============================================================
#  PhD LitReview Automator — Environment Variables Template
#  Copy to .env and fill in your keys. NEVER commit .env.
# ============================================================

# ── LLM Provider (Primary: Anthropic Claude) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── LangSmith Observability (free tier available) ────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=phd-litreview-automator
LANGSMITH_TRACING=true

# ── Semantic Scholar API ─────────────────────────────────────────────────
# Free at https://www.semanticscholar.org/product/api — 100 req/5min unauth
# Request authenticated key for 1 req/sec: https://api.semanticscholar.org/api-docs/
SEMANTIC_SCHOLAR_API_KEY=

# ── Elicit API ───────────────────────────────────────────────────────────
# https://elicit.com/api — paid tier for bulk research
ELICIT_API_KEY=

# ── Scite API ────────────────────────────────────────────────────────────
# https://scite.ai/api — smart citations with claim extraction
SCITE_API_KEY=

# ── Scholarcy API ────────────────────────────────────────────────────────
# https://ref.scholarcy.com/api/ — PDF structured extraction
SCHOLARCY_API_KEY=

# ── Perplexity API (academic mode) ───────────────────────────────────────
# https://www.perplexity.ai/api — for deep research queries
PERPLEXITY_API_KEY=pplx-...

# ── CORE API (open access papers) ────────────────────────────────────────
# https://core.ac.uk/services/api — free with registration
CORE_API_KEY=

# ── OpenAlex (free, no key required for most use) ───────────────────────
# https://docs.openalex.org/ — polite pool with email
OPENALEX_EMAIL=your.email@university.edu

# ── PubMed / NCBI ────────────────────────────────────────────────────────
NCBI_EMAIL=your.email@university.edu
NCBI_API_KEY=                    # Boosts rate limit from 3 to 10 req/sec

# ── Google APIs (for Google Docs integration) ────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=config/google_service_account.json
# OR use OAuth credentials:
GOOGLE_OAUTH_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_TOKEN_FILE=config/google_token.json

# Document IDs (from sharing links: /document/d/[DOCUMENT_ID]/edit)
LITREVIEW_GOOGLE_DOC_ID=1WukjXxp115ZNI4-u-1agm-5du1KG23iA
PROPOSAL_GOOGLE_DOC_ID=1lplSQtusQxbcey0Wluj-vtXeTkq90ewX
AI_FAILURES_GOOGLE_DOC_ID=1cP3t5cC1C0_lldC5ER480Z7FCGZwIVcV

# ── Email (Gmail SMTP / SendGrid) ────────────────────────────────────────
EMAIL_BACKEND=smtp                # Options: smtp | sendgrid | ses
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password   # Use Gmail App Password (not login password)
EMAIL_FROM=PhD LitReview Bot <your.email@gmail.com>
EMAIL_TO=your.email@university.edu
EMAIL_CC=                         # Optional comma-separated CCs

# ── SendGrid (alternative to SMTP) ───────────────────────────────────────
SENDGRID_API_KEY=SG...

# ── Pipeline Configuration ────────────────────────────────────────────────
MAX_PAPERS_PER_RUN=50             # Hard cap on papers to process daily
MIN_RELEVANCE_SCORE=6.0           # Papers below this are excluded (0-10 scale)
RELEVANCE_CITATION_BOOST=0.5     # Extra score per 100 citations (capped at 2.0)
DAYS_LOOKBACK=7                   # How many days back to search for new papers
HUMAN_REVIEW_CHECKPOINT=false     # Set true to pause before doc updates
MAX_RETRIES=3                     # API call retries
RETRY_DELAY=2.0                   # Initial retry delay in seconds

# ── Storage ───────────────────────────────────────────────────────────────
SQLITE_DB_PATH=storage/pipeline_state.db
PAPERS_DB_PATH=storage/papers_db.json
OUTPUTS_DIR=outputs

# ── Scheduling (when running locally; GitHub Actions has its own schedule) ─
CRON_SCHEDULE=0 6 * * *           # 6 AM UTC daily
TIMEZONE=UTC

# ── Debug / Development ────────────────────────────────────────────────────
DEBUG=false
DRY_RUN=false                     # If true, skip actual API writes and emails
LOG_LEVEL=INFO
