# ============================================================
#  PhD LitReview Automator — Environment Variables Template
#  Copy to .env and fill in your keys. NEVER commit .env.
#  Leave optional keys blank: a placeholder value switches the
#  integration on with an invalid key.
#
#  For GitHub Actions, the same names become repository secrets
#  and variables — see scripts/setup_github_secrets.sh.
# ============================================================

# ── LLM Provider (Anthropic Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Used automatically when the primary model errors or refuses a request
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-4-6
# Optional: override every agent's reasoning effort (low | medium | high | xhigh | max)
ANTHROPIC_EFFORT=

# ── LangSmith Observability (optional, free tier available) ──────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phd-litreview-automator
LANGSMITH_TRACING=false

# ── Semantic Scholar API ─────────────────────────────────────────────────
# Works without a key (shared rate limit); request a key for 1 req/sec:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── OpenAlex ─────────────────────────────────────────────────────────────
# Keyless requests share a small daily budget per IP address and fail once it
# is used up (always the case on GitHub Actions). Keys are free:
# https://help.openalex.org/api/authentication/
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# ── Optional research APIs ───────────────────────────────────────────────
ELICIT_API_KEY=          # https://elicit.com/api
SCITE_API_KEY=           # https://scite.ai/api — citation quality signals
SCHOLARCY_API_KEY=       # https://ref.scholarcy.com/api/ — PDF extraction
PERPLEXITY_API_KEY=      # https://www.perplexity.ai/api
CORE_API_KEY=            # https://core.ac.uk/services/api
NCBI_EMAIL=
NCBI_API_KEY=

# ── Google Docs integration (optional) ───────────────────────────────────
# Service account (recommended; also what GitHub Actions uses). Share both
# documents with the service account's e-mail address as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=config/google_service_account.json
# OR personal OAuth: save the client file below, then run `python main.py google-auth`
GOOGLE_OAUTH_CREDENTIALS_FILE=config/google_credentials.json
GOOGLE_TOKEN_FILE=config/google_token.json

# Document IDs (from the link: /document/d/[DOCUMENT_ID]/edit). They must be
# native Google Docs — an uploaded .docx must first be saved as a Google Doc.
LITREVIEW_GOOGLE_DOC_ID=1WukjXxp115ZNI4-u-1agm-5du1KG23iA
PROPOSAL_GOOGLE_DOC_ID=1lplSQtusQxbcey0Wluj-vtXeTkq90ewX
AI_FAILURES_GOOGLE_DOC_ID=1cP3t5cC1C0_lldC5ER480Z7FCGZwIVcV

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_BACKEND=smtp                # smtp | sendgrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                     # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=
SMTP_PASSWORD=                    # Gmail: an App Password, not your login password
EMAIL_FROM=                       # Defaults to SMTP_USER, e.g. PhD LitReview Bot <you@gmail.com>
EMAIL_TO=
EMAIL_CC=                         # Optional, comma-separated
SENDGRID_API_KEY=                 # Only for EMAIL_BACKEND=sendgrid

# ── Pipeline Configuration ────────────────────────────────────────────────
MAX_PAPERS_PER_RUN=50             # Cap on papers analyzed per run
LLM_CONCURRENCY=4                 # Papers extracted/analyzed in parallel
MIN_RELEVANCE_SCORE=6.0           # Papers below this are excluded (0-10 scale)
RELEVANCE_CITATION_BOOST=0.5      # Extra score per 100 citations (capped at 2.0)
DAYS_LOOKBACK=21                  # Overlapping window: sources index papers late
HUMAN_REVIEW_CHECKPOINT=false     # true = pause before doc updates (local runs only)

# ── Storage ───────────────────────────────────────────────────────────────
SQLITE_DB_PATH=storage/pipeline_state.db
PAPERS_DB_PATH=storage/papers_db.json
OUTPUTS_DIR=outputs

# ── Local scheduling (`python main.py schedule`; GitHub Actions has its own) ─
CRON_SCHEDULE=17 6 * * 1          # Mondays 06:17
TIMEZONE=UTC

# ── Debug / Development ────────────────────────────────────────────────────
DRY_RUN=false                     # true = no email, no document or database writes
LOG_LEVEL=INFO
